# ---------- Class8 (СЛОЖНОЕ) ----------
# Класс Hero: name, health, damage; to_dict(), from_dict(data).
# Сохранить в словарь, создать новый объект, вывести health.

class Hero:
    def __init__(self, name, health, damage):
        self.name = name
        self.health = health
        self.damage = damage

    def to_dict(self):
        return {
            "name": self.name,
            "health": self.health,
            "damage": self.damage,
        }

    @staticmethod
    def from_dict(data):
        return Hero(data["name"], data["health"], data["damage"])

name = input()
health = int(input())
damage = float(input())

original = Hero(name, health, damage)
data = original.to_dict()
restored = Hero.from_dict(data)
print(restored.health)
