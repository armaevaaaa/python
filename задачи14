import random

prices = {"зелье": 10, "масло": 15, "эликсир": 40}

enemy_stats = {
    "скелет":       {"hp": 45, "damage": 6, "loot": 25},
    "упырь":        {"hp": 30, "damage": 4, "loot": 15},
    "паук":         {"hp": 20, "damage": 3, "loot": 10},
    "летучая мышь": {"hp": 12, "damage": 2, "loot": 5},
}


def hero_hit(strike_n, damage, crit_damage):
    if strike_n % 3 == 0:
        return crit_damage, True
    return damage, False


def fight(enemy, hero_health, bonus, damage, crit_damage):
    stats = enemy_stats[enemy]
    enemy_hp = float(stats["hp"])
    rounds = []
    round_n = 0

    print(f"Ты спускаешься по ступеням. Из темноты выходит {enemy}!")

    while enemy_hp > 0 and hero_health > 0:
        round_n += 1
        hit, crit = hero_hit(round_n, damage, crit_damage)
        hit = hit + bonus
        enemy_hp -= hit

        line = f"Раунд {round_n}: ты наносишь {hit:.1f}"
        if crit:
            line += " — критический!"

        if enemy_hp <= 0:
            line += f" {enemy.capitalize()} падает замертво."
            rounds.append([round_n, hit, 0])
        else:
            blow = stats["damage"]
            hero_health -= blow
            line += f" Здоровье врага: {enemy_hp:.1f}. {enemy.capitalize()} бьёт в ответ на {blow}."
            rounds.append([round_n, hit, blow])

        print(line)

    won = enemy_hp <= 0
    loot = stats["loot"] if won else 0

    return rounds, won, hero_health, loot


def buy(price, gold, quantity=1):
    cost = price * quantity
    if gold >= cost:
        return gold - cost, True
    return gold, False


