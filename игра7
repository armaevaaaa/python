# Автор: Армаева София
# Дата: сентябрь 2026
#
# Пункт 4 – «прислушаться к эху»: тратит 1 единицу сил.
# Пункт 5 – «зачерпнуть воды»: восстанавливает 5 здоровья.
# Пункт 6 – «тренировка»: серия ударов, каждый третий — критический;
#           серия утомляет (−5 сил).
# Пункт 7 – «спуститься глубже»: встреча со случайным врагом,
#           бой раундами, побеждённый удаляется из списка.
# Пункт 0 – выход из подземелья.
#
# Правило истощения: движение стоит 2 силы. При нехватке —
# недостающее списывается из здоровья, запас обнуляется.
#
# Защита (этап 6):
#  - настройка перечитывает ВСЕ 4 числа при любой ошибке;
#  - свои правила: health > 0, остальные >= 0, endurance >= 2;
#  - меню: int(choice) + диапазон 0..7;
#  - прощание в finally — при выходе, гибели и Ctrl+C.
#
# Списки и random (этап 7):
#  - enemies = [...] до цикла, живой список (побеждённых удаляем);
#  - log = [] — журнал раундов для этапа 8.
# ==============================================================

import random


# --- Заголовок ---

title = "КОЛОДЕЦ У СТАРОЙ МЕЛЬНИЦЫ"
frame = "=" * 31

print(frame)
print(" " + title + " ")
print(frame)

print()


# --- Знакомство с героем ---

print("Как зовут героя?")
hero_name = input()

print(f"Добро пожаловать, {hero_name}!")
print("Ты спускаешься в колодец. Ветер гудит в старых досках, внизу чернеет вода.")
print()


# --- Настройка героя (защищённая) ---

print("Настройка героя.")
print("Здоровье, сила, ловкость, выносливость – по одному числу в строке:")

while True:
    try:
        health = int(input())
        strength = int(input())
        agility = int(input())
        endurance = int(input())
        
        if health <= 0:
            raise ValueError(f"Здоровье должно быть положительным, а введено {health}")
        if strength < 0 or agility < 0 or endurance < 0:
            raise ValueError("Сила, ловкость и выносливость не могут быть отрицательными")
        if endurance < 2:
            raise ValueError(f"Выносливость должна быть не меньше 2, а введено {endurance}")
        
        break
    except ValueError as e:
        print(f"Ой: {e}. Введите все четыре числа снова:")

print()


# --- Расчёт урона ---

base_attack = 10
damage = base_attack + strength * 1.5
crit_damage = damage * 2

# Запас сил: 1 единица умения за каждые 2 очка выносливости
stamina = endurance // 2


# --- Враги и журнал (списки) ---

enemies = ["скелет", "упырь", "паук", "летучая мышь"]
log = []


# --- Формуляр героя ---

print("Характеристики героя:")
print(f"Здоровье:     {health}")
print(f"Сила:         {strength}")
print(f"Ловкость:     {agility}")
print(f"Выносливость: {endurance}")
print()
print(f"Урон героя: {damage:.1f}")
print(f"Критический урон: {crit_damage:.1f}")
print(f"Запас сил: {stamina}")
print()


# --- Главный цикл игры (в try/except/finally) ---

running = True
actions = 0
menu_last = 7
outcome = "прерывание"

try:
    while running:
        print("Что делаешь?")
        print("1 - осмотреться")
        print("2 - идти вперёд")
        print("3 - отдохнуть")
        print("4 - прислушаться к эху")
        print("5 - зачерпнуть воды")
        print("6 - тренировка")
        print("7 - спуститься глубже")
        print("0 - выйти из подземелья")
        
        # --- Универсальная проверка пункта меню ---
        while True:
            choice = input()
            try:
                menu_number = int(choice)
            except ValueError:
                print("Такого пункта нет. Введи номер пункта из меню.")
                continue
            if 0 <= menu_number <= menu_last:
                break
            print("Такого пункта нет. Введи номер пункта из меню.")
        
        match choice:
            case "0":
                print("Ты поднимаешься обратно к свету. Колодец остаётся позади.")
                outcome = "выход"
                running = False
            
            case "1":
                print("Ты осматриваешься. Вокруг сырые доски колодца, на стенах блестит мох.")
            
            case "2":
                cost = 2
                if stamina >= cost:
                    stamina -= cost
                    print("Ты осторожно спускаешься по скользким ступеням. Доски скрипят под ногами.")
                else:
                    health -= cost - stamina
                    stamina = 0
                    print("Сил больше нет — ты идёшь на одном упорстве.")
            
            case "3":
                stamina += 5
                print("Ты садишься на выступ и переводишь дыхание. Силы возвращаются.")
            
            case "4":
                stamina -= 1
                print("Ты замираешь и слушаешь. Эхо уходит вниз, в чёрную воду, и возвращается тихим гулом.")
            
            case "5":
                health += 5
                print("Ты зачерпываешь студёной воды. Она обжигает горло, но возвращает бодрость.")
            
            case "6":
                strikes = 6
                crit_every = 3
                total_damage = 0.0
                crit_count = 0
                
                print("Ты подходишь к старому срубу мельницы.")
                print("На нём укреплён столб с перекладиной — здесь когда-то проверяли силу.")
                print()
                print(f"Наносишь {strikes} ударов.")
                
                for i in range(1, strikes + 1):
                    if i % crit_every == 0:
                        hit_damage = crit_damage
                        is_crit = True
                    else:
                        hit_damage = damage
                        is_crit = False
                    
                    if is_crit:
                        print(f"Удар {i}: {hit_damage:.1f} — критический!")
                    else:
                        print(f"Удар {i}: {hit_damage:.1f}")
                    
                    total_damage += hit_damage
                    if is_crit:
                        crit_count += 1
                
                print()
                print(f"Итог: {strikes} ударов, критических ударов: {crit_count}")
                print(f"Общий урон: {total_damage:.1f}")
                print(f"Средний урон: {total_damage / strikes:.1f}")
                
                stamina -= 5
                print("Тренировка отняла много сил.")
            
            case "7":
                if not enemies:
                    print("Ты спускаешься глубже, но подземелье пусто.")
                else:
                    enemy = random.choice(enemies)
                    enemy_hp = 45
                    round_n = 0
                    hero_strikes = 0
                    
                    print(f"Ты спускаешься по ступеням. Из темноты выходит {enemy}!")
                    
                    while enemy_hp > 0 and health > 0:
                        round_n += 1
                        hero_strikes += 1
                        
                        # Удар героя — каждый третий критический
                        if hero_strikes % 3 == 0:
                            hit = crit_damage
                            crit_mark = " — критический!"
                        else:
                            hit = damage
                            crit_mark = ""
                        
                        enemy_hp -= hit
                        print(f"Раунд {round_n}: ты наносишь {hit:.1f} урона{crit_mark} Здоровье врага: {max(enemy_hp, 0):.1f}.")
                        
                        if enemy_hp <= 0:
                            print(f"{enemy} падает замертво.")
                            break
                        
                        # Ответный удар врага
                        enemy_hit = random.randint(2, 6)
                        health -= enemy_hit
                        print(f"{enemy} бьёт в ответ на {enemy_hit}.")
                        
                        log.append(f"раунд {round_n}: герой -{hit:.1f}, {enemy} -{enemy_hit}")
                    
                    if enemy_hp <= 0:
                        enemies.remove(enemy)
                        print(f"{enemy} повержен! В подземелье осталось врагов: {len(enemies)}.")
                        print(f"Бой: {round_n} раундов.")
                        print(f"Последняя запись журнала: {log[-1]}")
                    elif health <= 0:
                        # Проверка смерти после match сработает сама
                        print(f"{enemy} наносит последний удар.")
        
        # Счётчик действий (выход не считается)
        if running:
            actions += 1
        
        # Проверка гибели — внутри цикла, после match
        if health <= 0:
            print(f"{hero_name} падает без сил. Колодец забирает ещё одного искателя.")
            outcome = "гибель"
            running = False
        
        # Строка состояния
        print()
        print(f"Здоровье: {health:<4} Запас сил: {stamina}  Врагов осталось: {len(enemies)}")

except KeyboardInterrupt:
    print()
    print("Ты резко оборачиваешься — и выбираешься наружу. Сеанс прерван.")

finally:
    print()
    print(frame)
    if outcome == "гибель":
        print(f"Ты не дошёл, {hero_name}. Колодец стал твоей могилой. Действий: {actions}.")
    elif outcome == "выход":
        print(f"Забег окончен, {hero_name}. Ты выбрался к свету. Действий: {actions}.")
    else:
        print(f"Сеанс прерван, {hero_name}. Действий: {actions}.")
    print(f"Раундов в журнале: {len(log)}.")
    print(frame)
