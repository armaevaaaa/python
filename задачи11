# ---------- Dict11 ----------
# Даны N слов. Построить словарь-счётчик: слово → сколько раз встретилось.
# Вывести каждое слово и его счёт в порядке первого появления.

n = int(input())
counts = {}
for i in range(n):
    word = input()
    counts[word] = counts.get(word, 0) + 1
for word, count in counts.items():
    print(f"{word}: {count}")


# ---------- Dict12 (СЛОЖНОЕ) ----------
# Построить словарь из N пар с различными значениями.
# Построить обращённый словарь: значение → ключ.
# Вывести его пары в порядке добавления исходного.

n = int(input())
d = {}
for i in range(n):
    key = input()
    value = int(input())
    d[key] = value

inverted = {}
for key, value in d.items():
    inverted[value] = key

for key, value in inverted.items():
    print(f"{key}: {value}")


# ---------- Dict13 (СЛОЖНОЕ) ----------
# Построить словарь из N троек: название, цена, количество.
# Значение — список [цена, количество].
# Вывести суммарную стоимость склада и название самого дорогого
# по стоимости предмета.

n = int(input())
d = {}
for i in range(n):
    name = input()
    price = int(input())
    qty = int(input())
    d[name] = [price, qty]

total_cost = 0
best_name = None
best_cost = -1
for name, props in d.items():
    price, qty = props
    cost = price * qty
    total_cost += cost
    if cost > best_cost:
        best_cost = cost
        best_name = name

print(total_cost)
print(best_name)


# ---------- Dict14 (СЛОЖНОЕ) ----------
# Построить словарь из N пар и число V.
# Удалить все пары со значением меньше V,
# не меняя словарь во время перебора. Вывести размер после удаления.

n = int(input())
d = {}
for i in range(n):
    key = input()
    value = int(input())
    d[key] = value
v = int(input())

for key in list(d):
    if d[key] < v:
        del d[key]

print(len(d))


# ---------- Dict15 ----------
# Построить словари из N и M пар. Добавить в первый пары второго
# без update: только ключи, которых нет; совпавшие ключи считать
# проигнорированными. Вывести размер и число проигнорированных.

n = int(input())
d1 = {}
for i in range(n):
    key = input()
    value = int(input())
    d1[key] = value

m = int(input())
d2 = {}
for i in range(m):
    key = input()
    value = int(input())
    d2[key] = value

ignored = 0
for key, value in d2.items():
    if key in d1:
        ignored += 1
    else:
        d1[key] = value

print(len(d1))
print(ignored)
