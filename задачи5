rest = n
while rest % 3 == 0:
    rest //= 3
print(rest == 1)

# While5
n = int(input())
k = 0
while n > 1:
    n //= 2
    k += 1
print(k)

# While6
n = int(input())
result = 1.0
k = n
while k > 0:
    result *= k
    k -= 2
print(result)

