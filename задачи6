# If3_protect
try:
    number = int(input())
except ValueError:
    print("Ошибка ввода")
else:
    if number > 0:
        number += 1
    elif number < 0:
        number -= 2
    else:
        number = 10
    print(number)

# While11_protect
try:
    n = int(input())
except ValueError:
    print("Ошибка ввода")
else:
    total = 0
    k = 0
    while total < n:
        k += 1
        total += k
    print(k)
    print(total)
