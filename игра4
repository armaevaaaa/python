#
# Пункт 4 – «прислушаться к эху»: герой замирает и слушает,
# как звук уходит вниз, в темноту колодца — тратит 1 единицу
# запаса сил на напряжённое вслушивание.
#
# Пункт 5 – «зачерпнуть воды»: герой наклоняется к чёрной воде
# и пьёт — восстанавливает здоровье, но набирает холод.
#
# Пункт 6 – «тренировка»: у старого сруба, что остался от мельницы,
# стоит столб с перекладиной — на нём когда-то проверяли силу.
# Герой бьёт по нему серию ударов; каждый третий — критический.
# ==============================================================


# --- Заголовок ---

title = "КОЛОДЕЦ У СТАРОЙ МЕЛЬНИЦЫ"
frame = "=" * 31

print(frame)
print(" " + title + " ")
print(frame)

print()


# --- Знакомство с героем ---

print("Как зовут героя?")
hero_name = input()

print(f"Добро пожаловать, {hero_name}!")
print("Ты спускаешься в колодец. Ветер гудит в старых досках, внизу чернеет вода.")
print()


# --- Настройка героя ---

print("Настройка героя.")
print("Здоровье, сила, ловкость, выносливость – по одному числу в строке:")

health = int(input())
strength = int(input())
agility = int(input())
endurance = int(input())

print()


# --- Расчёт урона ---

base_attack = 10
damage = base_attack + strength * 1.5
crit_damage = damage * 2

# Запас сил: 1 единица умения за каждые 2 очка выносливости
stamina = endurance // 2


# --- Формуляр героя ---

print("Характеристики героя:")
print(f"Здоровье:     {health}")
print(f"Сила:         {strength}")
print(f"Ловкость:     {agility}")
print(f"Выносливость: {endurance}")
print()
print(f"Урон героя: {damage:.1f}")
print(f"Критический урон: {crit_damage:.1f}")
print(f"Запас сил: {stamina}")
print()


# --- Меню действий ---

print("Что делаешь?")
print("1 - осмотреться")
print("2 - идти вперёд")
print("3 - отдохнуть")
print("4 - прислушаться к эху")
print("5 - зачерпнуть воды")
print("6 - тренировка")
print()


# --- Выбор действия ---

choice = input()

match choice:
    case "1":
        print("Ты осматриваешься. Вокруг сырые доски колодца, на стенах блестит мох.")
    
    case "2":
        stamina = stamina - 3
        print("Ты осторожно спускаешься по скользким ступеням. Доски скрипят под ногами.")
    
    case "3":
        stamina = stamina + 5
        print("Ты садишься на выступ и переводишь дыхание. Силы возвращаются.")
    
    case "4":
        stamina = stamina - 1
        print("Ты замираешь и слушаешь. Эхо уходит вниз, в чёрную воду, и возвращается тихим гулом.")
    
    case "5":
        health = health + 5
        print("Ты зачерпываешь студёной воды. Она обжигает горло, но возвращает бодрость.")
    
    case "6":
        # Тренировка у старого сруба мельницы
        strikes = 6
        crit_every = 3  # каждый третий удар — критический
        total_damage = 0.0
        crit_count = 0
        
        print("Ты подходишь к старому срубу мельницы.")
        print("На нём укреплён столб с перекладиной — здесь когда-то проверяли силу.")
        print()
        print(f"Наносишь {strikes} ударов.")
        
        for i in range(1, strikes + 1):
            # 1. Определяем урон текущего удара
            if i % crit_every == 0:
                hit_damage = crit_damage
                is_crit = True
            else:
                hit_damage = damage
                is_crit = False
            
            # 2. Печатаем удар
            if is_crit:
                print(f"Удар {i}: {hit_damage:.1f} — критический!")
            else:
                print(f"Удар {i}: {hit_damage:.1f}")
            
            # 3. Накопление
            total_damage = total_damage + hit_damage
            if is_crit:
                crit_count = crit_count + 1
        
        # --- Итог боя ---
        print()
        print(f"Итог: {strikes} ударов, критических ударов: {crit_count}")
        print(f"Общий урон: {total_damage:.1f}")
        print(f"Средний урон: {total_damage / strikes:.1f}")
        
        # Стоимость тренировки: заметно утомляет, больше, чем дорога (−3)
        stamina = stamina - 5
        print("Тренировка отняла много сил.")
    
    case _:
        print("Такого действия нет. Ты просто стоишь на месте.")


# --- Состояние героя ---

print()
print(f"Здоровье: {health:<4} Запас сил: {stamina}")
print()


# --- Прощание ---

print(frame)
print(f"Удачи, {hero_name}!")
print(frame)
