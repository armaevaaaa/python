# ---------- File5 ----------
# Дано имя файла целых чисел. Найти количество элементов.
# Если файла нет — вывести -1.

name = input()
if not os.path.exists(name):
    print(-1)
else:
    with open(name, encoding="utf-8") as f:
        count = 0
        for line in f:
            if line.strip() != "":
                count += 1
        print(count)


# ---------- File6 ----------
# Дано K и файл целых чисел. Вывести K-й элемент (с 1).
# Если нет — вывести -1.

k = int(input())
name = input()
with open(name, encoding="utf-8") as f:
    nums = [int(line) for line in f if line.strip()]
if 1 <= k <= len(nums):
    print(nums[k - 1])
else:
    print(-1)


