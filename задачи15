# ---------- File8 ----------
# Даны имена двух файлов: первый существует и непуст, второй отсутствует.
# Создать второй и записать в него первый и последний элементы первого.

src = input()
dst = input()
with open(src, encoding="utf-8") as f:
    nums = [int(line) for line in f if line.strip()]
with open(dst, "w", encoding="utf-8") as f:
    f.write(str(nums[0]) + "\n")
    f.write(str(nums[-1]) + "\n")


# ---------- File9 (СЛОЖНОЕ) ----------
# Даны имена двух файлов: один существует и непуст (не обязательно первый),
# другой отсутствует. Создать отсутствующий и записать в него
# конечный и начальный элементы существующего.

name1 = input()
name2 = input()

if os.path.exists(name1):
    src, dst = name1, name2
else:
    src, dst = name2, name1

with open(src, encoding="utf-8") as f:
    nums = [int(line) for line in f if line.strip()]
with open(dst, "w", encoding="utf-8") as f:
    f.write(str(nums[-1]) + "\n")
    f.write(str(nums[0]) + "\n")


# ---------- File10 ----------
# Дан файл целых чисел. Создать новый файл с теми же элементами
# в обратном порядке.

src = input()
dst = input()
with open(src, encoding="utf-8") as f:
    nums = [int(line) for line in f if line.strip()]
with open(dst, "w", encoding="utf-8") as f:
    for x in nums[::-1]:
        f.write(str(x) + "\n")
