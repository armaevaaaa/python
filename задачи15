# ---------- File2 ----------
# Дано имя файла и N (> 1). Записать N первых положительных чётных чисел.

name = input()
n = int(input())
with open(name, "w", encoding="utf-8") as f:
    for i in range(1, n + 1):
        f.write(str(2 * i) + "\n")


# ---------- File3 ----------
# Дано имя файла и вещественные A и D.
