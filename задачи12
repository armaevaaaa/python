
# ---------- String1 ----------
# Дан символ C. Вывести его код (номер в кодовой таблице).

c = input()
print(ord(c))


# ---------- String2 ----------
# Дано целое N (32 ≤ N ≤ 126). Вывести символ с кодом N.

n = int(input())
print(chr(n))


# ---------- String3 ----------
# Дан символ C. Вывести символы, предшествующий C и следующий за ним.

c = input()
print(chr(ord(c) - 1))
print(chr(ord(c) + 1))


# ---------- String4 ----------
# Дано N (1 ≤ N ≤ 26). Вывести строку из N первых заглавных латинских букв.

n = int(input())
result = ""
for i in range(n):
    result += chr(ord("A") + i)
print(result)


# ---------- String5 (СЛОЖНОЕ) ----------
# Дано N (1 ≤ N ≤ 26). Вывести строку из N последних строчных
# латинских букв в обратном порядке, начиная с «z».

n = int(input())
result = ""
for i in range(n):
    result += chr(ord("z") - i)
print(result)


# ---------- String6 ----------
# Дан символ C (цифра или буква). Вывести «digit», «lat» или «rus».

c = input()
if "0" <= c <= "9":
    print("digit")
elif "a" <= c <= "z" or "A" <= c <= "Z":
    print("lat")
else:
    print("rus")


# ---------- String7 ----------
# Дана непустая строка. Вывести коды её первого и последнего символа.

s = input()
print(ord(s[0]))
print(ord(s[-1]))


# ---------- String8 ----------
# Даны N (> 0) и символ C. Вывести строку длины N из символов C.

n = int(input())
c = input()
print(c * n)


# ---------- String9 (СЛОЖНОЕ) ----------
# Даны чётное N (> 0) и символы C1, C2.
# Вывести строку длины N из чередующихся C1 и C2, начиная с C1.

n = int(input())
c1 = input()
c2 = input()
result = ""
for i in range(n):
    if i % 2 == 0:
        result += c1
    else:
        result += c2
print(result)


# ---------- String10 ----------
# Дана строка. Вывести строку, содержащую те же символы
# в обратном порядке.

s = input()
print(s[::-1])


# ---------- String11 ----------
# Дана непустая строка S. Вывести строку, содержащую символы S,
# между которыми вставлено по одному пробелу.

s = input()
print(" ".join(s))


# ---------- String12 ----------
# Даны непустая строка S и N (> 0). Вывести строку из символов S,
# между которыми вставлено по N звёздочек.

s = input()
n = int(input())
sep = "*" * n
print(sep.join(s))


# ---------- String13 ----------
# Дана строка. Подсчитать количество содержащихся в ней цифр.

s = input()
count = 0
for ch in s:
    if ch.isdigit():
        count += 1
print(count)


# ---------- String14 ----------
# Дана строка. Подсчитать количество прописных латинских букв в ней.

s = input()
count = 0
for ch in s:
    if "A" <= ch <= "Z":
        count += 1
print(count)


# ---------- String15 (СЛОЖНОЕ) ----------
# Дана строка. Подсчитать общее количество строчных латинских
# и русских букв в ней.

s = input()
alphabet = "abcdefghijklmnopqrstuvwxyz" + "абвгдеёжзийклмнопрстуфхцчшщъыьэюя"
count = 0
for ch in s:
    if ch in alphabet:
        count += 1
print(count)
