import random


# --- Константы ---

title = "КОЛОДЕЦ У СТАРОЙ МЕЛЬНИЦЫ"
frame = "=" * 31

enemies = ["скелет", "упырь", "паук", "летучая мышь"]
log = []


# ==============================================================
# ФУНКЦИИ (определения — до главного цикла, до любых вызовов)
# ==============================================================

def hero_hit(strike_n):
    """Урон героя в удар номер strike_n.

    Возвращает пару (hit, crit): урон и признак критического удара.
    Читает глобальные правила damage и crit_damage, не меняет ничего.
    """
    if strike_n % 3 == 0:
        return crit_damage, True
    return damage, False


def fight(enemy, hero_health):
    """Бой с enemy до гибели одного из двоих.

    Печатает строки раундов. Возвращает (rounds, won, hero_health):
    таблицу раундов, признак победы героя и здоровье после боя.
    Глобальные переменные не меняет: здоровье приходит параметром
    и возвращается новым значением.
    """
    enemy_hp = 45.0
    rounds = []
    round_n = 0

    print(f"Ты спускаешься по ступеням. Из темноты выходит {enemy}!")

    while enemy_hp > 0 and hero_health > 0:
        round_n += 1
        hit, crit = hero_hit(round_n)
        enemy_hp -= hit

        line = f"Раунд {round_n}: ты наносишь {hit:.1f}"
        if crit:
            line += " — критический!"

        if enemy_hp <= 0:
            line += f" {enemy.capitalize()} падает замертво."
            rounds.append([round_n, hit, 0])
        else:
            blow = random.randint(2, 6)
            hero_health -= blow
            line += f" Здоровье врага: {enemy_hp:.1f}. {enemy.capitalize()} бьёт в ответ на {blow}."
            rounds.append([round_n, hit, blow])

        print(line)

    return rounds, enemy_hp <= 0, hero_health


def print_leaderboard(log):
    """Печатает топ-3 раундов по урону героя и рекорд врага.

    Возвращает None: контракт функции — печать, а не данные.
    """
    if not log:
        print("Ты ещё не сражался.")
        return

    top = sorted(log, key=lambda r: r[1], reverse=True)[:3]
    print("Таблица лидеров (урон героя):")
    for i in range(len(top)):
        print(f"{i + 1}. Раунд {top[i][0]}: {top[i][1]:.1f}")

    worst = max(log, key=lambda r: r[2])
    print(f"Самый сильный удар врага: {worst[2]} (раунд {worst[0]}).")


def print_run_summary(log):
    """Печатает итог забега: суммарный и средний урон героя.

    Возвращает None. Безопасна на пустом журнале.
    """
    total = sum(r[1] for r in log)
    rounds = len(log)
    if rounds > 0:
        print(f"Урон: {total:.1f} за {rounds} раундов, в среднем {total / rounds:.1f}.")
    else:
        print("В этом забеге не было боёв.")


# ==============================================================
# СЮЖЕТ
# ==============================================================

# --- Заголовок ---

print(frame)
print(" " + title + " ")
print(frame)
print()


# --- Знакомство с героем ---

print("Как зовут героя?")
hero_name = input()

print(f"Добро пожаловать, {hero_name}!")
print("Ты спускаешься в колодец. Ветер гудит в старых досках, внизу чернеет вода.")
print()


# --- Настройка героя (защищённая) ---

print("Настройка героя.")
print("Здоровье, сила, ловкость, выносливость – по одному числу в строке:")

while True:
    try:
        health = int(input())
        strength = int(input())
        agility = int(input())
        endurance = int(input())

        if health <= 0:
            raise ValueError(f"Здоровье должно быть положительным, а введено {health}")
        if strength < 0 or agility < 0 or endurance < 0:
            raise ValueError("Сила, ловкость и выносливость не могут быть отрицательными")
        if endurance < 2:
            raise ValueError(f"Выносливость должна быть не меньше 2, а введено {endurance}")

        break
    except ValueError as e:
        print(f"Ой: {e}. Введите все четыре числа снова:")

print()


# --- Расчёт урона ---

base_attack = 10
damage = base_attack + strength * 1.5
crit_damage = damage * 2

stamina = endurance // 2


# --- Формуляр героя ---

print("Характеристики героя:")
print(f"Здоровье:     {health}")
print(f"Сила:         {strength}")
print(f"Ловкость:     {agility}")
print(f"Выносливость: {endurance}")
print()
print(f"Урон героя: {damage:.1f}")
print(f"Критический урон: {crit_damage:.1f}")
print(f"Запас сил: {stamina}")
print()


# --- Главный цикл игры ---

running = True
actions = 0
menu_last = 8
outcome = "прерывание"

try:
    while running:
        print("Что делаешь?")
        print("1 - осмотреться")
        print("2 - идти вперёд")
        print("3 - отдохнуть")
        print("4 - прислушаться к эху")
        print("5 - зачерпнуть воды")
        print("6 - тренировка")
        print("7 - спуститься глубже")
        print("8 - лидерборд")
        print("0 - выйти из подземелья")

        # --- Универсальная проверка пункта меню ---
        while True:
            choice = input()
            try:
                menu_number = int(choice)
            except ValueError:
                print("Такого пункта нет. Введи номер пункта из меню.")
                continue
            if 0 <= menu_number <= menu_last:
                break
            print("Такого пункта нет. Введи номер пункта из меню.")

        match choice:
            case "0":
                print("Ты поднимаешься обратно к свету. Колодец остаётся позади.")
                outcome = "выход"
                running = False

            case "1":
                print("Ты осматриваешься. Вокруг сырые доски колодца, на стенах блестит мох.")

            case "2":
                cost = 2
                if stamina >= cost:
                    stamina -= cost
                    print("Ты осторожно спускаешься по скользким ступеням. Доски скрипят под ногами.")
                else:
                    health -= cost - stamina
                    stamina = 0
                    print("Сил больше нет — ты идёшь на одном упорстве.")

            case "3":
                stamina += 5
                print("Ты садишься на выступ и переводишь дыхание. Силы возвращаются.")

            case "4":
                stamina -= 1
                print("Ты замираешь и слушаешь. Эхо уходит вниз, в чёрную воду, и возвращается тихим гулом.")

            case "5":
                health += 5
                print("Ты зачерпываешь студёной воды. Она обжигает горло, но возвращает бодрость.")

            case "6":
                strikes = 6
                total_damage = 0.0
                crit_count = 0

                print("Ты подходишь к старому срубу мельницы.")
                print("На нём укреплён столб с перекладиной — здесь когда-то проверяли силу.")
                print()
                print(f"Наносишь {strikes} ударов.")

                for i in range(1, strikes + 1):
                    hit_damage, crit = hero_hit(i)
                    if crit:
                        crit_count += 1
                        print(f"Удар {i}: {hit_damage:.1f} — критический!")
                    else:
                        print(f"Удар {i}: {hit_damage:.1f}")
                    total_damage += hit_damage

                print()
                print(f"Итог: {strikes} ударов, критических ударов: {crit_count}")
                print(f"Общий урон: {total_damage:.1f}")
                print(f"Средний урон: {total_damage / strikes:.1f}")

                stamina -= 5
                print("Тренировка отняла много сил.")

            case "7":
                if not enemies:
                    print("Ты спускаешься глубже, но подземелье пусто.")
                else:
                    enemy = random.choice(enemies)
                    rounds, won, health = fight(enemy, health)
                    for r in rounds:
                        log.append(r)
                    if won:
                        enemies.remove(enemy)
                        print(f"{enemy.capitalize()} повержен! В подземелье осталось врагов: {len(enemies)}.")
                        print(f"Бой: {len(rounds)} раундов.")

            case "8":
                print_leaderboard(log)

        # Счётчик действий (выход не считается)
        if running:
            actions += 1

        # Проверка гибели
        if health <= 0:
            print(f"{hero_name} падает без сил. Колодец забирает ещё одного искателя.")
            outcome = "гибель"
            running = False

        # Строка состояния
        print()
        print(f"Здоровье: {health:<4} Запас сил: {stamina}  Врагов осталось: {len(enemies)}")

except KeyboardInterrupt:
    print()
    print("Ты резко оборачиваешься — и выбираешься наружу. Сеанс прерван.")

finally:
    print()
    print(frame)
    if outcome == "гибель":
        print(f"Ты не дошёл, {hero_name}. Колодец стал твоей могилой. Действий: {actions}.")
    elif outcome == "выход":
        print(f"Забег окончен, {hero_name}. Ты выбрался к свету. Действий: {actions}.")
    else:
        print(f"Сеанс прерван, {hero_name}. Действий: {actions}.")
    print_run_summary(log)
    print(frame)
